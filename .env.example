# Rimal backend environment variables

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/rimal_db

# HTTP port
PORT=10000

# Internal API guard key (must match the frontend API key)
REMAL_SECURE_KEY=your_internal_api_key

# ---- RateHawk / Emerging Travel Group (ETG) B2B API v3 ----
# The legacy hosts api.worldota.net / api-sandbox.worldota.net are DEPRECATED.
# Use the ratehawk.com hosts, driven entirely by RATEHAWK_BASE_URL:
#   Sandbox:    https://api-sandbox.ratehawk.com/api/b2b/v3
#   Production: https://api.ratehawk.com/api/b2b/v3
# (A bare host, e.g. https://api-sandbox.ratehawk.com, is also accepted — the code
#  normalizes it since it also calls /api/content/v1/* endpoints.)
RATEHAWK_BASE_URL=https://api-sandbox.ratehawk.com/api/b2b/v3
# API key ID  -> HTTP Basic Auth username   (aka RATEHAWK_API_ID)
RATEHAWK_KEY_ID=your_key_id
# API key access token -> HTTP Basic Auth password   (aka RATEHAWK_API_TOKEN)
RATEHAWK_API_KEY=your_api_key_token

# Public frontend base URL. Used to build the booking return_path.
# SECURITY: ETG validates that return_path is HTTPS and its host matches the
# domain registered in your ETG account settings, or the booking is failed.
FRONTEND_URL=https://remalbookings.com

# Region resolution for search. The frontend sends the app's destinationCode
# (e.g. "DXB"), which is NOT an ETG region id and does not resolve via
# multicomplete. Map codes -> ETG region ids (JSON), and/or set a default region.
# Region ids differ between sandbox and production (e.g. Dubai = 6053839 in
# sandbox). Set these to your PRODUCTION region ids before go-live.
# RATEHAWK_DESTINATION_REGION_MAP={"DXB":6053839}
# RATEHAWK_DEFAULT_REGION_ID=6053839
