# Sandbox template only. Keep real credentials in ignored .env.sandbox or Render.
NODE_ENV=development
PORT=10000
MONGO_URI=mongodb://127.0.0.1/rimal_sandbox
PAYMENT_SANDBOX_DATABASE=rimal_sandbox
RIMAL_AUTH_REALM=rimal-staging
RATEHAWK_BASE_URL=https://api-sandbox.ratehawk.com
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_BOOKING_TOKEN=
FRONTEND_URL=https://rimal-api-staging.onrender.com
STAGING_FRONTEND_ORIGIN=https://rimal-api-staging.onrender.com
VITE_API_BASE_URL=https://rimal-api-staging.onrender.com/api
ZIINA_API_KEY=
ZIINA_ACCOUNT_ID=
ZIINA_WEBHOOK_SECRET=
ZIINA_TEST_MODE=true
PAYMENT_BOOKING_ENCRYPTION_KEY=
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_ETG_SANDBOX_ISOLATED=true
# Enable gates only after validating the matching provider configuration.
PAYMENT_ROLLOUT_APPROVED=false
PAYMENT_PRODUCTION_APPROVED=false
PAYMENT_CHECKOUT_ENABLED=false
RATEHAWK_BOOKING_ENABLED=false
RATEHAWK_CANCELLATION_ENABLED=false
ZIINA_REFUNDS_ENABLED=false
ZIINA_WEBHOOK_CONFIGURED=false
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=sandbox-admin@example.test
ADMIN_PASSWORD_HASH=
