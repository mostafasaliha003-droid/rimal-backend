:["Sun Deck"],"non_free_amenities":null,"group_name":"Recreation"},{"amenities":["Parking","Parking nearby","Garage"],"non_free_amenities":null,"group_name":"Parking"},{"amenities":["Swimming pool","Spa tub","Indoor Pool"],"non_free_amenities":null,"group_name":"Pool and beach"},{"amenities":["Business center","Fax and copy machine","Meeting and presentation facilities","Conference Hall"],"non_free_amenities":null,"group_name":"Business"},{"amenities":["Fitness facilities"],"non_free_amenities":null,"group_name":"Sports"},{"amenities":["Doctor","Steam room","Beauty services","Sauna","First Aid Kit"],"non_free_amenities":["Beauty services"],"group_name":"Beauty and wellness"},{"amenities":["Babysitting and childcare","Children swimming pool","Family/Kid Friendly"],"non_free_amenities":null,"group_name":"Kids"},{"amenities":["Pets Not Allowed"],"non_free_amenities":null,"group_name":"Pets"},{"amenities":["Temperature control for staff","Personal protection equipment for staff","Extra decontamination measures","Temperature control for guests","Personal protection equipment for guests","Contactless check-in and/or check-out","Individually packaged food","Additional measures against COVID-19"],"non_free_amenities":null,"group_name":"Health and Safety Measures"}],"check_in_time":"14:00:00","check_in_time_end":"","check_out_time":"12:00:00","description_struct":[{"paragraphs":["<em>InterContinental Residence Suites Dubai Festival City, an IHG Hotel</em> is located in 7 km from the city center. You can take a walk and explore the neighbourhood area of the hotel. Places nearby: Airport Terminal 1, Dubai Creek and Dubai Mall."],"title":"Location"},{"paragraphs":["Spend an evening in a nice atmosphere of the bar. It’s time to have a nice meal! Stop by the restaurant. Have a cup of coffee in the cafe and, who knows, maybe it’s going to be the best one in the city. Free Wi-Fi is available on the territory. Ask for more information when checking in.","If you travel by car, there’s a parking zone. Also, the following services are available for guests at the hotel: a sauna. Guests who love doing sports will be able to enjoy a fitness center, a gym and a 24-hour gym. Swimming fans are going to enjoy a pool, an indoor pool and an outdoor pool.","For participants of business meetings will be able to use a business center, a conference hall, event facilities. The tour assistance desk of the hotel will help you book an excursion. If you want to make your journey even more comfortable, you can order a transfer. Accessible for guests with disabilities: the elevator helps them to go to the highest floors.","At the guests’ disposal, there’s also a laundry, dry cleaning, an ATM, private check-in and check-out, ironing, press, car rental, a safe-deposit box and a concierge. The staff of the hotel will be happy to talk to you in English and German."],"title":"At the hotel"},{"paragraphs":["Guests will find the following in the room: a DVD player, an alarm clock, a shower, a TV, a mini-bar, a bathrobe and slippers. The room equipment depends on its category."],"title":"Room amenities"}],"email":"reservation.dfc@ihg.com","hotel_chain":"","hid":7393910,"id":"intercontinental_residence_suite_dubai_festival_city","images_ext":[{"url":"https://cdn.worldota.net/t/{size}/ostrovok/17/05/1705d2fbc23daa05162e9cb0f03dd8fa6fa07ed3.JPEG","category_slug":"unspecified"},{"url":"https://cdn.worldota.net/t/{size}/ostrovok/0b/07/0b074c6388d018f8b55eaaf5209a969fb5b94964.JPEG","category_slug":"unspecified"},{"url":"https://cdn.worldota.net/t/{size}/ostrovok/b7/33/b733682a1f5ee7839298ac9a87e05e0db90202dd.JPEG","category_slug":"unspecified"},{"url":"https://cdn.worldota.net/t/{size}/ostrovok/79/10/7910c18dd42e57e24c2542bd8f2576e2c6542ca1.JPEG","category_slug":"unspecified"},{"url":"https://cdn.worldota.net/t/{size}/ostrovok/dc/2a/dc2a0aa86b881df38827327f6cb0214a6c0f1282.JPEG","category_slug":"unspecified"},{"url":"https://cdn.worldota.net/t/{size}/ostrovok/81/82/81826ac725fac5