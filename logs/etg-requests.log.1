essibility"},{"amenities":["Iron and board","Ironing","Luggage storage","Laundry","Safe-deposit box","Concierge services","Dry-cleaning","Shoe shine","Luggage storage","Wake-up service","Telephone","Iron"],"non_free_amenities":["Ironing","Laundry","Dry-cleaning","Shoe shine"],"group_name":"Services and amenities"},{"amenities":["Diet menu (on request)","Breakfast","Buffet breakfast","Breakfast in the room","Cafe","Restaurant","Kitchen","Microwave oven","Packed Lunches","Kettle"],"non_free_amenities":null,"group_name":"Meals"},{"amenities":["Free Wi-Fi","In-room internet"],"non_free_amenities":null,"group_name":"Internet"},{"amenities":["Shuttle","Car rental","Transfer services"],"non_free_amenities":["Shuttle","Car rental"],"group_name":"Transfer"},{"amenities":["English","French","Arabic"],"non_free_amenities":null,"group_name":"Languages Spoken"},{"amenities":["Tour assistance"],"non_free_amenities":null,"group_name":"Tourist services"},{"amenities":["Sun Deck"],"non_free_amenities":null,"group_name":"Recreation"},{"amenities":["Parking","Garage"],"non_free_amenities":null,"group_name":"Parking"},{"amenities":["Swimming pool","Outdoor pool","Pool facilities","Beach/pool towels","Rooftop pool"],"non_free_amenities":null,"group_name":"Pool and beach"},{"amenities":["Business center","Conference Hall"],"non_free_amenities":null,"group_name":"Business"},{"amenities":["Fitness facilities"],"non_free_amenities":null,"group_name":"Sports"},{"amenities":["Sauna","First Aid Kit"],"non_free_amenities":null,"group_name":"Beauty and wellness"},{"amenities":["Babysitting and childcare","Children's playground","Children swimming pool","Family/Kid Friendly","Kids' TV Networks"],"non_free_amenities":null,"group_name":"Kids"},{"amenities":["Pets Not Allowed"],"non_free_amenities":null,"group_name":"Pets"},{"amenities":["Temperature control for staff","Extra decontamination measures","Temperature control for guests","Contactless check-in and/or check-out","Additional measures against COVID-19"],"non_free_amenities":null,"group_name":"Health and Safety Measures"}],"check_in_time":"14:00:00","check_in_time_end":"","check_out_time":"12:00:00","description_struct":[{"paragraphs":["<em>Savoy Suites Hotel Apartments</em> is located in Dubai. This hotel is located in walking distance from the city center."],"title":"Location"},{"paragraphs":["You can stop by the bar. It’s time to have a nice meal! Stop by the restaurant. Have a cup of coffee in the cafe and, who knows, maybe it’s going to be the best one in the city. Free Wi-Fi is available on the territory. Ask for more information when checking in.","If you travel by car, there’s a parking zone. Also, the following services are available for guests at the hotel: a sauna and a steam bath. Sports fans are going to love a fitness center and a gym. Swimming fans are going to enjoy a pool and an outdoor pool.","For participants of business meetings, there is a conference hall. The tour assistance desk of the hotel will help you book an excursion. The staff of the hotel will order a transfer for you. Accessible for guests with disabilities: the elevator helps them to go to the highest floors.","Additional services that the hotel offers to its guests: a laundry, dry cleaning, private check-in and check-out, ironing, press, car rental, a safe-deposit box and a concierge. The staff of the hotel will be happy to talk to you in English."],"title":"At the hotel"},{"paragraphs":["Here’s what you’ll find in the room to have a rest after a long day: an alarm clock, a shower, a TV, a mini-bar, a bathrobe and slippers. Please note that the listed services may not be available in all the rooms."],"title":"Room amenities"}],"email":"suites@savoydubai.ae","hotel_chain":"","hid":7446951,"id":"savoy_suites_9","images_ext":[{"url":"https://cdn.worldota.net/t/{size}/content/2e/ea/2eea8fb670414906efd7a79a6b5d4dbdf84d5f50.jpeg","category_slug":"unspecified"},{"url":"https://cdn.worldota.net/t/{size}/content/ee/9a/ee9aa8ee0