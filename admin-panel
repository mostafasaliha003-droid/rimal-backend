<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة الإدارة المشفرة | شركة الرمال الدولية 🔐</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --primary: #1f3a40; --accent-cyan: #00b4d8; --accent-coral: #ff595e; --accent-purple: #7209b7; --bg-light: #f7fff7; }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Cairo', sans-serif; }
        body { background-color: var(--bg-light); color: var(--primary); padding: 20px; }
        .admin-container { max-width: 1100px; margin: 40px auto; background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 4px solid var(--accent-purple); }
        .login-box { max-width: 400px; margin: 100px auto; background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 4px solid var(--accent-purple); text-align: center; }
        .form-group { margin-bottom: 15px; text-align: right; }
        .form-group label { display: block; font-weight: 900; margin-bottom: 5px; }
        .form-group input { width: 100%; padding: 12px; border-radius: 10px; border: 2px solid #cbd5e1; font-family: 'Cairo'; }
        .btn { background: var(--accent-purple); color: white; border: none; padding: 12px 20px; border-radius: 10px; font-weight: 900; cursor: pointer; width: 100%; transition: 0.3s; }
        .btn:hover { background: #3c096c; }
        table { width: 100%; border-collapse: collapse; text-align: right; margin-top: 15px; }
        th, td { padding: 12px; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
        th { background: #f1f5f9; color: var(--primary); }
    </style>
</head>
<body>

    <!-- نافذة تسجيل دخول الإدارة السرية -->
    <div id="loginSection" class="login-box">
        <h2 style="color: var(--accent-purple); margin-bottom: 20px;"><i class="fa-solid fa-user-shield"></i> بوابة الإدارة السرية</h2>
        <form onsubmit="adminLogin(event)">
            <div class="form-group">
                <label>اسم المستخدم الإداري:</label>
                <input type="email" id="admUser" required placeholder="admin@remaltourismllc.com">
            </div>
            <div class="form-group">
                <label>كلمة المرور المشفرة:</label>
                <input type="password" id="admPass" required placeholder="••••••••">
            </div>
            <button type="submit" class="btn">دخول لوحة التحكم 🔐</button>
        </form>
    </div>

    <!-- لوحة التحكم الإدارية (تظهر حصرياً بعد إدخال بيانات المشرف الصحيح) -->
    <div id="dashboardSection" class="admin-container" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 3px dashed var(--accent-purple); padding-bottom: 15px; margin-bottom: 25px;">
            <h2>🛠️ لوحة تحكم شركة الرمال الدولية (الإدارة)</h2>
            <button onclick="adminLogout()" style="background: var(--accent-coral); color: white; border: none; padding: 8px 15px; border-radius: 8px; font-weight: bold; cursor: pointer;">تسجيل خروج</button>
        </div>

        <div style="margin-bottom: 30px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="color: var(--primary);"><i class="fa-solid fa-suitcase-rolling"></i> كافة الحجوزات النشطة وإدارة استرداد الأموال</h3>
                <button onclick="loadAdminData()" style="background: var(--accent-cyan); color: white; border: none; padding: 6px 12px; border-radius: 8px; font-weight: bold; cursor: pointer;"><i class="fa-solid fa-rotate"></i> تحديث</button>
            </div>
            <div id="bookingsTableContainer" style="overflow-x: auto;">جاري تحميل الحجوزات...</div>
        </div>

        <div>
            <h3 style="color: var(--primary); margin-bottom: 10px;"><i class="fa-solid fa-users"></i> قائمة العملاء المسجلين في النظام</h3>
            <div id="usersTableContainer" style="overflow-x: auto;">جاري تحميل العملاء...</div>
        </div>
    </div>

    <script>
        let token = localStorage.getItem('rimal_admin_token') || null;

        if (token) {
            document.getElementById('loginSection').style.display = 'none';
            document.getElementById('dashboardSection').style.display = 'block';
            loadAdminData();
        }

        async function adminLogin(e) {
            e.preventDefault();
            const username = document.getElementById('admUser').value;
            const password = document.getElementById('admPass').value;
            try {
                const res = await fetch('/api/admin/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });
                const data = await res.json();
                if (data.success) {
                    token = data.token;
                    localStorage.setItem('rimal_admin_token', token);
                    document.getElementById('loginSection').style.display = 'none';
                    document.getElementById('dashboardSection').style.display = 'block';
                    loadAdminData();
                } else { alert('❌ ' + data.error); }
            } catch (err) { alert('خطأ في الاتصال بالخادم'); }
        }

        async function loadAdminData() {
            try {
                const res = await fetch('/api/admin/data', { headers: { 'Authorization': token } });
                const data = await res.json();
                if (data.success) {
                    let bHtml = `<table><tr><th>المرجع</th><th>العميل</th><th>البريد</th><th>الهاتف</th><th>الفندق</th><th>المبلغ</th><th>الإجراء</th></tr>`;
                    if(data.bookings.length === 0) {
                        bHtml += `<tr><td colspan="7" style="text-align:center; padding:15px;">لا توجد حجوزات نشطة حالياً.</td></tr>`;
                    } else {
                        data.bookings.forEach(b => {
                            bHtml += `<tr><td><b>${b.bookingReference}</b></td><td>${b.customerName}</td><td>${b.email}</td><td>${b.phone || '-'}</td><td>${b.hotelName}</td><td>${b.price} AED</td><td><button onclick="cancelAndRefund('${b.bookingReference}')" style="background:#d90429; color:white; border:none; padding:6px 12px; border-radius:6px; cursor:pointer; font-weight:bold;">إلغاء واسترداد</button></td></tr>`;
                        });
                    }
                    bHtml += `</table>`;
                    document.getElementById('bookingsTableContainer').innerHTML = bHtml;

                    let uHtml = `<table><tr><th>الاسم</th><th>البريد الإلكتروني</th><th>الهاتف</th><th>الجنسية</th><th>النقاط</th></tr>`;
                    if(data.users.length === 0) {
                        uHtml += `<tr><td colspan="5" style="text-align:center; padding:15px;">لا توجد حسابات مسجلة حالياً.</td></tr>`;
                    } else {
                        data.users.forEach(u => {
                            uHtml += `<tr><td><b>${u.name}</b></td><td>${u.email}</td><td>${u.phone || '-'}</td><td>${u.nationality || '-'}</td><td><span style="color:var(--accent-purple); font-weight:bold;">${u.points} نقطة</span></td></tr>`;
                        });
                    }
                    uHtml += `</table>`;
                    document.getElementById('usersTableContainer').innerHTML = uHtml;
                } else {
                    adminLogout();
                }
            } catch (e) { alert('خطأ في تحميل البيانات الإدارية'); }
        }

        async function cancelAndRefund(bookingReference) {
            if (!confirm(`هل أنت متأكد من إلغاء الحجز (${bookingReference}) وإرسال إشعار استرداد الأموال للعميل؟`)) return;
            try {
                const res = await fetch('/api/admin/cancel-booking', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': token },
                    body: JSON.stringify({ bookingReference })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✅ ' + data.message);
                    loadAdminData();
                } else { alert('❌ ' + data.error); }
            } catch (err) { alert('خطأ في تنفيذ عملية الإلغاء'); }
        }

        function adminLogout() {
            localStorage.removeItem('rimal_admin_token');
            token = null;
            document.getElementById('dashboardSection').style.display = 'none';
            document.getElementById('loginSection').style.display = 'block';
        }
    </script>
</body>
</html>
