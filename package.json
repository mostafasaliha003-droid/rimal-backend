{
  "name": "rimal-backend",
  "version": "1.0.0",
  "description": "Rimal International Booking System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend run build && npm run prepare:site",
    "prepare:site": "node syncFrontendBuild.js",
    "check:site": "node syncFrontendBuild.js --check",
    "sync:filtered-hotels": "node syncFilteredHotels.js",
    "sync:hotel-search-index": "node syncHotelSearchIndex.js",
    "test:hotel-search-index": "node --test test-hotel-search-index.js",
    "sync:hotel-reviews": "node syncHotelReviews.js",
    "check:limits": "node checkApiLimits.js",
    "sync:hotel-dump": "node syncHotelDump.js",
    "sync:incremental-dump": "node syncIncrementalDump.js",
    "sync:custom-dump": "node syncCustomDump.js",
    "sync:reviews-dump": "node syncReviewsDump.js",
    "sync:region-dump": "node syncRegionDump.js",
    "sync:incremental-reviews-dump": "node syncIncrementalReviewsDump.js",
    "sync:poi-dump": "node syncPoiDump.js",
    "sync:static-dictionary": "node syncStaticDictionary.js",
    "test:pricing-service": "node --test test/pricing-service.test.js",
    "test:hotelbeds": "node --test test-hotelbeds-client.js test-hotelbeds-content-voucher.js test/hotelbeds-content-import.test.js test/hotelbeds-content-terms.test.js test-hotelbeds-availability.js test-hotelbeds-mock-content-seed.js",
    "test:offer-cache": "node --test test/offer-cache.test.js",
    "test:offer-normalization": "node --test test-offer-normalization.js",
    "test:search-orchestrator": "node --test test/search-orchestrator.test.js",
    "test:live-fx-service": "node --test test/live-fx-service.test.js",
    "test:booking-flow": "node --test test/booking-flow.test.js",
    "test:hotelbeds-reconciliation": "node --test test/hotelbeds-reconciliation-route.test.js",
    "test:hotelbeds-prepaid-booking": "node --test test/hotelbeds-prepaid-booking.test.js",
    "test:hotelbeds-live-aggregate": "node --test test/hotelbeds-live-aggregate.test.js",
    "test:multi-supplier-search": "node --test test/multi-supplier-search.test.js",
    "test:checkout-state-machine": "node --test test/checkout-state-machine.test.js",
    "seed:hotelbeds-mock-content": "node scripts/seed-mock-hotelbeds-content.js",
    "sync:hotelbeds-content": "node scripts/sync-hotelbeds-content.js",
    "test:hotelbeds-content-sync": "node --test test/hotelbeds-content-sync-script.test.js test/hotelbeds-content-sync-state.test.js",
    "test:hotelbeds-content-sync-mongo": "node --test test/hotelbeds-content-sync-mongo.integration.test.js",
    "test:readiness": "node --test test-deployment-readiness.js test-server-startup.cjs test-booking-record-persistence.js",
    "plan:hotelbeds-content": "node scripts/plan-hotelbeds-content-import.js",
    "test:hotelbeds-content-plan": "node --test test-hotelbeds-content-import.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "mongoose": "^8.3.1",
    "nodemailer": "^6.9.13",
    "puppeteer": "^22.0.0",
    "simple-zstd": "^2.1.0",
    "socket.io": "^4.7.2",
    "stripe": "^15.2.0"
  }
}
