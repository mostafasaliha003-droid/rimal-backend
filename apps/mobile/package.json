{
  "name": "@remal/mkhadda",
  "version": "0.2.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint",
    "export:web": "expo export --platform web --output-dir .expo-preview/web",
    "export:android": "expo export --platform android --output-dir .expo-preview/android",
    "test:unit": "node --test src/api/__tests__/client.test.cjs src/api/__tests__/bookings.test.cjs src/components/calendarModel.test.cjs src/components/guestAgeModel.test.cjs src/components/hotelPoliciesData.test.cjs src/components/foundationContracts.test.cjs src/components/offerReviewModel.test.cjs",
    "test:build": "node --test scripts/__tests__/android-preview-attempt.test.cjs",
    "preview:web": "node scripts/serve-preview.cjs",
    "export:preview": "expo export --platform web --platform android --output-dir .expo-preview/verified"
  },
  "private": true,
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  }
}
